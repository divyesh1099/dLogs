# Set as a Railway service variable (Settings > Variables), not in a committed .env.
NTFY_BASE_URL=https://ntfy.yourdomain.com

# Do not add NTFY_SMTP_SENDER_* here — outbound SMTP is blocked on Railway's
# network (confirmed with both Gmail and Resend, see README.md). Email
# notifications don't work from this deployment.

# Optional: locks down the entrust-timer-logs topic only (see README.md
# "Locking down individual topics"). Leave both unset to keep every topic
# open as before — this isn't a global auth switch. NTFY_LOGS_USER is just
# a login name here (created with role=user, not --role=admin) — it only
# gets the topic access explicitly granted below, nothing more.
NTFY_LOGS_USER=admin
NTFY_LOGS_PASSWORD=<generate a long random secret, not your personal password>
